# Sentinel Quiz web (Next.js) — environment variables.
# Copy to web/.env.local for local development. Never commit real secrets.

# Public origin of the FastAPI backend as seen by the browser, e.g. https://api.example.com
# Read at request time on the server and injected into the page (window.__SENTINEL_RUNTIME__),
# so it can change without rebuilding the image. Leave empty when the API is served on the
# same origin under /api (nginx in docker-compose, or the dev rewrite below).
API_ORIGIN=

# Legacy fallback for API_ORIGIN. NEXT_PUBLIC_* values are inlined at BUILD time.
NEXT_PUBLIC_API_ORIGIN=

# Where `next dev` proxies /api/* when API_ORIGIN is empty (default http://127.0.0.1:8000).
# Setting it at build time also enables the rewrite for `next start` without nginx.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Name of the backend session cookie used by the /admin route guard in middleware.ts.
AUTH_COOKIE_NAME=sentinel_session

# /admin guard: auto (default: only when the API shares the web host), on, off.
ADMIN_ROUTE_GUARD=auto
