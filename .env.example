# Local development: FastAPI running directly from backend/ (no containers).
#   cd backend && cp ../.env.example .env
# For Docker / Portainer use .env.docker.example (APP_* prefixed names).
# Values below are dev-friendly; the backend itself defaults to production
# (fail-closed) when APP_ENV is not set.

APP_ENV=development
ENFORCE_PRODUCTION_SAFETY=true

# --- Content paths (relative to backend/) ---
QUESTION_JSON_DIR=../questions
# Licensed EPUBs live here locally (git-ignored; never commit them).
MATERIAL_DIR=../material

# --- Database ---
# docker run --rm --name sentinel-pg -e POSTGRES_DB=sentinel_quiz \
#   -e POSTGRES_USER=sentinel -e POSTGRES_PASSWORD=sentinel -p 5432:5432 postgres:16-alpine
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@127.0.0.1:5432/sentinel_quiz
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_PRE_PING=true
# Schema is managed by Alembic: run `alembic upgrade head` in backend/ first.
BOOTSTRAP_SCHEMA=false
# Import ../questions/*.json on startup (or call POST /api/admin/ingest).
INGEST_ON_STARTUP=true
STUDY_TRACK_DIR=
# /docs and /openapi.json (default: on outside production).
EXPOSE_API_DOCS=true

# --- Auth / cookies ---
AUTH_TOKEN_TTL_HOURS=168
AUTH_TOKEN_BYTES=32
AUTH_COOKIE_NAME=sentinel_session
# Plain http://127.0.0.1 in dev; must be true in production (HTTPS).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_RETURN_TOKEN_IN_BODY=false
AUTH_LAST_USED_THROTTLE_SECONDS=300
AUTH_SLIDING_SESSION=true
AUTH_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=1440
AUTH_PASSWORD_RESET_TTL_MINUTES=60
PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000

# --- SMTP (empty host = e-mails are not sent) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sentinel Quiz
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=20

# --- Logging / request tracing ---
LOG_LEVEL=INFO
LOG_JSON=true
SLOW_REQUEST_THRESHOLD_MS=1200
TRUST_REQUEST_ID_HEADER=true
# No proxy in front of uvicorn locally: never trust X-Forwarded-For here.
TRUST_FORWARDED_FOR_HEADER=false

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
# memory is fine for a single dev process; production requires redis.
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_ALLOW_MEMORY_IN_PRODUCTION=false
RATE_LIMIT_AUTH_SENSITIVE_REQUESTS=10
RATE_LIMIT_AUTH_SENSITIVE_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_REQUESTS=180
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=40
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_REQUESTS=60
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60
RATE_LIMIT_CACHE_SIZE=50000
ABUSE_SIGNAL_ENABLED=true
ABUSE_SIGNAL_WINDOW_SECONDS=60
ABUSE_DISTINCT_PATH_THRESHOLD=30
ABUSE_RATE_LIMIT_BREACH_THRESHOLD=3
ABUSE_SIGNAL_COOLDOWN_SECONDS=300

# --- CORS (Next dev server on :3000) ---
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- AI tutor (Gemini) ---
GEMINI_ENABLE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0
GEMINI_TIMEOUT_SECONDS=20
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=400
GEMINI_SYSTEM_PROMPT=
GEMINI_MIN_RESPONSE_CHARS=220
GEMINI_RETRY_ON_SHORT=true
GEMINI_CANDIDATE_COUNT=1
TUTOR_DAILY_QUOTA=40

# --- Sentinel Arena: live quizzes (docs/live-quiz/CONTRATO-INCREMENTO-1.md §8) ---
LIVE_ENABLED=false
LIVE_HOST_POLICY=allowlist          # allowlist | verified_users | all (admins can always host)
LIVE_HOST_ALLOWLIST=
LIVE_TOKEN_KEYS=                    # kid:secret (>= 32 bytes); required in production when enabled
LIVE_BUS_BACKEND=memory             # memory (1 worker) | redis (several workers/replicas)
LIVE_REDIS_URL=                     # empty = REDIS_URL
LIVE_MAX_PARTICIPANTS=2000             # per room (GA); above it people wait in the waiting room
LIVE_WAITING_ROOM_MAX=2000             # people waiting per room (approval + overflow)
LIVE_WAITING_STALE_SECONDS=45          # a waiting phone silent this long loses its turn
LIVE_PLATFORM_GUEST_OK=false
RATE_LIMIT_LIVE_ROOM_REQUESTS=12000  # per room code per minute (never per IP; 2,000 joins in 20 s)
RATE_LIMIT_LIVE_TOKEN_REQUESTS=30    # /api/live/me/* per participant per minute
RATE_LIMIT_LIVE_CMD_REQUESTS=300     # SSE fallback commands per participant per minute
LIVE_INVALID_CODE_LIMIT=60           # wrong room codes per IP per 10 min before 429
LIVE_SSE_MAX_SECONDS=300
LIVE_METRICS_TOKEN=                  # Bearer for /api/live/metrics (empty: loopback only, never in production)

# --- Sentinel Arena: AI authoring (docs/live-quiz/CONTRATO-INCREMENTO-2.md §5) ---
AI_AUTHORING_ENABLED=false
AI_PROVIDER=gemini                  # gemini | fake (offline, dev/tests only)
AI_AUTHORING_MODEL=                 # empty = GEMINI_MODEL
AI_CRITIC_MODEL=                    # empty = same model
AI_CRITIC_ENABLED=true
AI_DAILY_QUOTA_CREDITS=300
AI_MAX_CONCURRENT_JOBS=2
AI_JOB_RUNNER=thread                # thread | worker (python -m app.services.ai_authoring.worker)
RATE_LIMIT_AI_REQUESTS=6

# --- Web (web/.env.local) ---
# NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000
# AUTH_COOKIE_NAME=sentinel_session      # must match AUTH_COOKIE_NAME above
# TUTOR_CLIENT_TIMEOUT_MS=45000           # browser timeout for tutor calls (5000..300000)
