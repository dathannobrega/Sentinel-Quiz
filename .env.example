# Local development (rodando FastAPI diretamente em `backend/`)
# Para Docker / Portainer, use `.env.docker.example`.

# Path to directory containing question JSON files
QUESTION_JSON_DIR=../questions

# SQLite DB path (relative to backend/)
DATABASE_URL=sqlite:///./securityplus.db
BOOTSTRAP_SCHEMA=true

# Optional: local material directory
MATERIAL_DIR=../material

# Admin API key required for /api/admin/*
ADMIN_API_KEY=change-me

# Opaque bearer token settings (hours for expiry, token entropy bytes)
AUTH_TOKEN_TTL_HOURS=168
AUTH_TOKEN_BYTES=32

# CORS origins for local frontend dev
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Gemini AI (tutor durante a prova)
GEMINI_ENABLE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=400
GEMINI_SYSTEM_PROMPT=
GEMINI_MIN_RESPONSE_CHARS=220
GEMINI_RETRY_ON_SHORT=true
GEMINI_CANDIDATE_COUNT=1
