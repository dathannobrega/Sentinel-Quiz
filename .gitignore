# OS / editor noise
**/.DS_Store
*.swp

# Secrets / local env files (keep the *.example templates tracked)
/.env
.env.local
backend/.env

# Python
/Extract_test.py
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/

# Local databases / dumps / logs
*.db
*.log
*.sqlite3
*.sqlite
*.bak
*.backup
/backups/

# Web
web/node_modules/
web/.next/

# Licensed study material: EPUB/PDF files are mounted at runtime
# (./material:/app/material:ro) and must never be committed.
material/*.epub
material/**/*.epub
material/*.pdf
material/**/*.pdf

# Private-study question imports (registry status personal_use): no redistribution
# rights, so they stay on the owner's machine (python -m scripts.question_sources import --personal-use).
questions/local/

# graphify knowledge-graph output
graphify-out/
