# =============================================================================
# Sentinel Quiz — container variables (docker compose / Portainer / docker run)
# =============================================================================
# cp .env.docker.example .env, then pick the stack with COMPOSE_FILE (below):
#   Development  docker-compose.yml + docker-compose.dev.yml (builds :local from source)
#                docker compose up --build -d
#   Production   docker-compose.yml + docker-compose.prod.yml (pre-built GHCR images)
#                docker login ghcr.io   # private packages: token with read:packages
#                docker compose pull && docker compose up -d
#   Portainer    stack file docker-compose.portainer.yml (same as base + prod in one
#                file); paste the variables you need into the stack "Environment
#                variables". COMPOSE_FILE is not used there.
# Production and Portainer REQUIRE APP_POSTGRES_PASSWORD and APP_NGINX_HOST.
#
# Every APP_<NAME> is exported to the API as <NAME> by docker/entrypoint.sh.
# An EMPTY value means "use the backend default" (see README, section
# "Variáveis de ambiente"). Values shown here are the defaults.

# -----------------------------------------------------------------------------
# Stack selection (read by docker compose itself; separator ":")
# -----------------------------------------------------------------------------
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# -----------------------------------------------------------------------------
# Production / Portainer only (ignored by the development stack)
# -----------------------------------------------------------------------------
# Image tag published by CI. Empty = "latest" (newest main build; refresh with
# `docker compose pull`). Pin sha-<7 chars> (or 1.2.3 for releases) for rollback.
# Tags are case-sensitive: "Latest" does not exist.
APP_IMAGE_TAG=
# Registry/repository prefix; the web and proxy images use the -web / -proxy suffix.
APP_IMAGE_REPOSITORY=ghcr.io/dathannobrega/sentinel-quiz
# Host folder with the licensed books (json/ and the EPUBs), mounted read-only at
# /app/material. Absolute path in Portainer; ./material works with the docker CLI.
# Empty = named volume "material_data" (copy the files into it yourself).
APP_MATERIAL_HOST_DIR=

# -----------------------------------------------------------------------------
# Stack / proxy
# -----------------------------------------------------------------------------
APP_CONTAINER_NAME=sentinel-quiz
APP_WEB_CONTAINER_NAME=sentinel-quiz-web
APP_NGINX_CONTAINER_NAME=sentinel-quiz-proxy
APP_HTTP_PORT=80
APP_HTTPS_PORT=443
# Public host name WITHOUT scheme, e.g. quiz.example.com (required in Portainer).
APP_NGINX_HOST=localhost
APP_NGINX_ALT_NAMES=
# TLS: "self-signed" (generated once, persisted in the proxy_certs volume and
# regenerated only when expiring or when the host names change) or "custom".
APP_TLS_MODE=self-signed
# Host directory mounted at /etc/nginx/certs (empty = named volume proxy_certs).
# For custom certs put server.crt/server.key there, or mount /etc/letsencrypt
# and point APP_TLS_CERTIFICATE / APP_TLS_CERTIFICATE_KEY to the live/ files.
APP_TLS_CERTS_DIR=
APP_TLS_CERTIFICATE=/etc/nginx/certs/server.crt
APP_TLS_CERTIFICATE_KEY=/etc/nginx/certs/server.key
APP_NGINX_CERT_DAYS=825
# nginx limit_req for /api/auth/* (defense in depth; the API has its own limiter).
APP_NGINX_AUTH_RATE=10r/s
APP_NGINX_AUTH_BURST=20
APP_NGINX_CLIENT_MAX_BODY_SIZE=2m
# Resource limits (docker compose deploy.resources.limits).
APP_API_CPUS=2.0
APP_API_MEMORY=1g
APP_WEB_CPUS=1.0
APP_WEB_MEMORY=512m
APP_PROXY_CPUS=0.5
APP_PROXY_MEMORY=128m
APP_POSTGRES_CPUS=1.0
APP_POSTGRES_MEMORY=1g
APP_REDIS_CPUS=0.5
APP_REDIS_MEMORY=192m

# -----------------------------------------------------------------------------
# Web (Next.js)
# -----------------------------------------------------------------------------
# Empty = same origin (the browser calls https://<APP_NGINX_HOST>/api through
# the proxy). Set only to force a different API origin, e.g. https://api.example.com
# (becomes NEXT_PUBLIC_API_ORIGIN and API_ORIGIN in the web container).
APP_PUBLIC_API_ORIGIN=
# Browser timeout (ms) for AI tutor calls (web container TUTOR_CLIENT_TIMEOUT_MS,
# read at runtime). 5000..300000; keep above APP_GEMINI_TIMEOUT_SECONDS.
APP_TUTOR_CLIENT_TIMEOUT_MS=45000
# APP_AUTH_COOKIE_NAME (below) is also passed to the web container as
# AUTH_COOKIE_NAME for the /admin route guard.

# -----------------------------------------------------------------------------
# Runtime / schema
# -----------------------------------------------------------------------------
# Empty = the stack's default: development for the dev stack, production for
# prod/Portainer. The backend itself defaults to production (fail-closed).
APP_ENV=
APP_ENFORCE_PRODUCTION_SAFETY=true
# `alembic upgrade head` before the API starts (PostgreSQL advisory lock makes
# concurrent replicas safe). Keep true.
APP_RUN_DB_MIGRATIONS=true
# Legacy create_all bootstrap. Must stay false (refused in production).
APP_BOOTSTRAP_SCHEMA=false
# Import questions/*.json once at container start (before the workers boot).
# Empty = the stack's default: true for dev, false for prod/Portainer (use
# POST /api/admin/ingest there).
APP_INGEST_ON_STARTUP=
APP_STUDY_TRACK_DIR=
# /docs and /openapi.json. Empty = backend default (off in production).
APP_EXPOSE_API_DOCS=
APP_UVICORN_WORKERS=2
# uvicorn --forwarded-allow-ips. "*" is safe ONLY because the API is not
# published and its sole client is the proxy on the internal network.
APP_FORWARDED_ALLOW_IPS=*
# Trust the X-Forwarded-For set by our nginx (right-most value). Keep true
# only while the API is reachable exclusively through the proxy.
APP_TRUST_FORWARDED_FOR_HEADER=true
APP_TRUST_REQUEST_ID_HEADER=true
# Optional env file mounted inside the API container (e.g. /run/config/app.env).
APP_ENV_FILE=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Leave APP_DATABASE_URL empty: the API builds
# postgresql+psycopg://APP_POSTGRES_USER:APP_POSTGRES_PASSWORD@postgres:5432/APP_POSTGRES_DB
# so postgres and the API can never drift apart. Set it only for an external DB.
APP_DATABASE_URL=
APP_POSTGRES_DB=sentinel_quiz
APP_POSTGRES_USER=sentinel
# DEV ONLY value. Use a long random secret anywhere else (openssl rand -base64 32);
# "sentinel" is rejected when APP_ENV=production.
APP_POSTGRES_PASSWORD=sentinel
APP_DB_POOL_SIZE=10
APP_DB_MAX_OVERFLOW=10
APP_DB_POOL_TIMEOUT=10
APP_DB_POOL_PRE_PING=true

# -----------------------------------------------------------------------------
# Web origin / CORS / auth cookies
# -----------------------------------------------------------------------------
# Empty = https://<APP_NGINX_HOST>.
APP_PUBLIC_WEB_ORIGIN=
# Empty = https://<APP_NGINX_HOST> (same origin; "*" is refused in production).
APP_CORS_ORIGINS=
APP_AUTH_TOKEN_TTL_HOURS=168
APP_AUTH_TOKEN_BYTES=32
APP_AUTH_COOKIE_NAME=sentinel_session
# The proxy always serves HTTPS, so the session cookie is Secure.
APP_AUTH_COOKIE_SECURE=true
APP_AUTH_COOKIE_SAMESITE=lax
APP_AUTH_COOKIE_DOMAIN=
# Session token is only in the HttpOnly cookie unless this is true (legacy clients).
APP_AUTH_RETURN_TOKEN_IN_BODY=false
APP_AUTH_LAST_USED_THROTTLE_SECONDS=300
APP_AUTH_SLIDING_SESSION=true
APP_AUTH_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
APP_AUTH_EMAIL_VERIFICATION_TTL_MINUTES=1440
APP_AUTH_PASSWORD_RESET_TTL_MINUTES=60

# -----------------------------------------------------------------------------
# SMTP (password reset / e-mail verification)
# -----------------------------------------------------------------------------
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_FROM_EMAIL=
APP_SMTP_FROM_NAME=Sentinel Quiz
APP_SMTP_USE_TLS=true
APP_SMTP_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_SLOW_REQUEST_THRESHOLD_MS=1200

# -----------------------------------------------------------------------------
# Rate limiting / abuse signals
# -----------------------------------------------------------------------------
APP_RATE_LIMIT_ENABLED=true
# redis is required in production (shared across workers/replicas).
APP_RATE_LIMIT_BACKEND=redis
APP_REDIS_URL=redis://redis:6379/0
APP_RATE_LIMIT_ALLOW_MEMORY_IN_PRODUCTION=false
APP_RATE_LIMIT_AUTH_SENSITIVE_REQUESTS=10
APP_RATE_LIMIT_AUTH_SENSITIVE_WINDOW_SECONDS=60
APP_RATE_LIMIT_PUBLIC_REQUESTS=180
APP_RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
APP_RATE_LIMIT_AUTH_REQUESTS=40
APP_RATE_LIMIT_AUTH_WINDOW_SECONDS=60
APP_RATE_LIMIT_ADMIN_REQUESTS=60
APP_RATE_LIMIT_ADMIN_WINDOW_SECONDS=60
APP_RATE_LIMIT_CACHE_SIZE=50000
APP_ABUSE_SIGNAL_ENABLED=true
APP_ABUSE_SIGNAL_WINDOW_SECONDS=60
APP_ABUSE_DISTINCT_PATH_THRESHOLD=30
APP_ABUSE_RATE_LIMIT_BREACH_THRESHOLD=3
APP_ABUSE_SIGNAL_COOLDOWN_SECONDS=300

# -----------------------------------------------------------------------------
# AI tutor (Gemini)
# -----------------------------------------------------------------------------
APP_GEMINI_ENABLE=true
APP_GEMINI_API_KEY=
APP_GEMINI_MODEL=gemini-2.5-flash
APP_GEMINI_THINKING_BUDGET=0
APP_GEMINI_TIMEOUT_SECONDS=20
APP_GEMINI_TEMPERATURE=0.2
APP_GEMINI_MAX_OUTPUT_TOKENS=400
APP_GEMINI_SYSTEM_PROMPT=
APP_GEMINI_MIN_RESPONSE_CHARS=220
APP_GEMINI_RETRY_ON_SHORT=true
APP_GEMINI_CANDIDATE_COUNT=1
# Tutor requests per user per day.
APP_TUTOR_DAILY_QUOTA=40

# --- Sentinel Arena: live quizzes -------------------------------------------------
# Off by default in production; the dev stack turns it on for every signed-in user.
# APP_LIVE_ENABLED=true
# allowlist (APP_LIVE_HOST_ALLOWLIST: e-mails/ids) | verified_users | all. Admins can always host.
# APP_LIVE_HOST_POLICY=allowlist
# APP_LIVE_HOST_ALLOWLIST=instrutor@example.com
# REQUIRED in production when enabled: "kid:secret" (secret >= 32 bytes, e.g. `openssl rand -hex 32`).
# Several keys "new:...,old:..." rotate without logging participants out (the first one signs).
# APP_LIVE_TOKEN_KEYS=k1:change-me-to-a-long-random-secret-of-32-bytes-or-more
# redis (default, needed with APP_UVICORN_WORKERS > 1) | memory (single worker only).
# APP_LIVE_BUS_BACKEND=redis
# APP_LIVE_REDIS_URL=          # empty = APP_REDIS_URL
# APP_LIVE_MAX_PARTICIPANTS=1000
# Items from third-party sources ("platform") in rooms open to guests: only after legal decision Q-19.
# APP_LIVE_PLATFORM_GUEST_OK=false
