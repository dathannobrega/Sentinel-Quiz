# Build context for the root Dockerfile (API image).
# Allowlist: everything is excluded unless re-included below, so licensed
# material, secrets, backups and the web app never reach the build context.
*

!backend/app
!backend/alembic
!backend/alembic.ini
!backend/requirements.txt
!backend/requirements.lock
!questions
# Private-study imports (personal_use sources) never enter the image.
questions/local
!docker/entrypoint.sh
# Study-track definitions (our own, non-licensed content) — exactly these three
# files; they are baked into the image at /app/study-tracks (STUDY_TRACK_DIR).
!material/Modulos_sec+.md
!material/cissp_domain.json
!material/ceh_modules.md

# Never ship these, even inside re-included directories. Everything else in
# material/ (licensed EPUB/PDF) stays excluded by the leading "*".
**/__pycache__
**/*.pyc
**/*.pyo
**/.DS_Store
**/.pytest_cache
**/.env
**/*.epub
**/*.pdf
