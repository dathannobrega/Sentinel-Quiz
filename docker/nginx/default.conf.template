# Sentinel Quiz reverse proxy (rendered by the nginx image's envsubst step).
# Only ${NGINX_*} variables defined in the container environment are replaced;
# nginx runtime variables ($host, $remote_addr, ...) are left untouched.

server_tokens off;

# Defense in depth for credential endpoints; the API keeps its own
# Redis-backed rate limiter (RATE_LIMIT_*), this only absorbs bursts early.
limit_req_zone $binary_remote_addr zone=sentinel_auth:10m rate=${NGINX_AUTH_RATE};
limit_req_status 429;
limit_req_log_level warn;

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types
  text/plain
  text/css
  text/xml
  text/javascript
  application/javascript
  application/json
  application/xml
  application/manifest+json
  image/svg+xml;

server {
  listen 80;
  listen [::]:80;
  server_name ${NGINX_SERVER_NAME};

  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${NGINX_SERVER_NAME};

  ssl_certificate ${NGINX_SSL_CERTIFICATE};
  ssl_certificate_key ${NGINX_SSL_CERTIFICATE_KEY};
  ssl_session_timeout 1d;
  ssl_session_cache shared:SentinelSSL:10m;
  ssl_session_tickets off;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  # Security headers. Content-Security-Policy is intentionally NOT set here:
  # the Next.js app emits a per-request nonce-based CSP (web/middleware.ts).
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  # The API only accepts small JSON bodies (no uploads).
  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

  proxy_http_version 1.1;
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;
  proxy_hide_header X-Powered-By;
  proxy_set_header Host $host;
  # Overwrite (never append) client-supplied forwarding headers: the API sees
  # exactly one address, the TCP peer nginx observed. See README "IP do cliente".
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Port 443;
  proxy_set_header X-Request-ID $request_id;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  location = /api {
    proxy_pass http://${NGINX_API_HOST}:${NGINX_API_PORT}/api;
  }

  location /api/auth/ {
    limit_req zone=sentinel_auth burst=${NGINX_AUTH_BURST} nodelay;
    proxy_pass http://${NGINX_API_HOST}:${NGINX_API_PORT};
  }

  location /api/ {
    proxy_pass http://${NGINX_API_HOST}:${NGINX_API_PORT};
  }

  location / {
    proxy_pass http://${NGINX_WEB_HOST}:${NGINX_WEB_PORT};
  }
}
