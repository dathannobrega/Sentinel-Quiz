# Sentinel Quiz reverse proxy (rendered by the nginx image's envsubst step).
# Only ${NGINX_*} variables defined in the container environment are replaced;
# nginx runtime variables ($host, $remote_addr, ...) are left untouched.

server_tokens off;

# Defense in depth for credential endpoints; the API keeps its own
# Redis-backed rate limiter (RATE_LIMIT_*), this only absorbs bursts early.
limit_req_zone $binary_remote_addr zone=sentinel_auth:10m rate=${NGINX_AUTH_RATE};
limit_req_status 429;
limit_req_log_level warn;

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types
  text/plain
  text/css
  text/xml
  text/javascript
  application/javascript
  application/json
  application/xml
  application/manifest+json
  image/svg+xml;

server {
  listen 80;
  listen [::]:80;
  server_name ${NGINX_SERVER_NAME};

  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${NGINX_SERVER_NAME};

  ssl_certificate ${NGINX_SSL_CERTIFICATE};
  ssl_certificate_key ${NGINX_SSL_CERTIFICATE_KEY};
  ssl_session_timeout 1d;
  ssl_session_cache shared:SentinelSSL:10m;
  ssl_session_tickets off;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  # Security headers — single source per response, no duplicates:
  #   * HSTS: always set here (server level, inherited by every location that
  #     has no add_header of its own; the API locations re-add it via the
  #     snippet because add_header in a location disables inheritance).
  #   * Next.js pages (location /): nosniff, X-Frame-Options DENY,
  #     Referrer-Policy, Permissions-Policy, COOP and the per-request nonce CSP
  #     come from the app itself (web/next.config.mjs + web/middleware.ts).
  #   * API (/api...): the same values are set here by
  #     snippets/api-security-headers.conf, which also hides upstream copies.
  # Keep the values in sync with web/next.config.mjs.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # The API only accepts small JSON bodies (no uploads).
  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

  proxy_http_version 1.1;
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;
  proxy_hide_header X-Powered-By;
  proxy_set_header Host $host;
  # Overwrite (never append) client-supplied forwarding headers: the API sees
  # exactly one address, the TCP peer nginx observed. See README "IP do cliente".
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Port 443;
  proxy_set_header X-Request-ID $request_id;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  location = /api {
    include /etc/nginx/snippets/api-security-headers.conf;
    proxy_pass http://${NGINX_API_HOST}:${NGINX_API_PORT}/api;
  }

  location /api/auth/ {
    limit_req zone=sentinel_auth burst=${NGINX_AUTH_BURST} nodelay;
    include /etc/nginx/snippets/api-security-headers.conf;
    proxy_pass http://${NGINX_API_HOST}:${NGINX_API_PORT};
  }

  # Sentinel Arena WebSocket (sq.live.v1): long-lived, no buffering. The server pings
  # every 15 s, so 75 s without traffic means the peer is gone.
  location = /api/live/ws {
    include /etc/nginx/snippets/api-security-headers.conf;
    proxy_pass http://${NGINX_API_HOST}:${NGINX_API_PORT};
    proxy_buffering off;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
  }

  # Server-Sent Events fallback (RNF-309): same as the socket, never buffered.
  location = /api/live/sse {
    include /etc/nginx/snippets/api-security-headers.conf;
    proxy_pass http://${NGINX_API_HOST}:${NGINX_API_PORT};
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
  }

  # Prometheus metrics are scraped inside the Docker network, never through nginx.
  location = /api/live/metrics {
    return 404;
  }

  location /api/ {
    include /etc/nginx/snippets/api-security-headers.conf;
    proxy_pass http://${NGINX_API_HOST}:${NGINX_API_PORT};
  }

  # Next.js: security headers + CSP are emitted by the app (see above).
  location / {
    proxy_pass http://${NGINX_WEB_HOST}:${NGINX_WEB_PORT};
  }
}
